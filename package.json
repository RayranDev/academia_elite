    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "^9.13.0",
    "dotenv": "^18.0.8",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "marked": "^18.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
