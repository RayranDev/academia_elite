    "db:reset": "node scripts/guardia-borrado.mjs && prisma migrate reset --force",
    "qa:entorno": "tsx scripts/qa/entorno.ts",
    "qa:detener": "tsx scripts/qa/detener.ts",
    "copy:imgly": "node scripts/copy-imgly-assets.mjs",
    "prebuild": "node scripts/copy-imgly-assets.mjs",
    "postinstall": "prisma generate && node scripts/copy-imgly-assets.mjs",
    "manuales:inventario": "node scripts/manuales/inventario.mjs",
    "manuales:cobertura": "node scripts/manuales/cobertura.mjs",
    "manuales:indice": "node scripts/manuales/indice.mjs",
    "manuales:optimizar": "node scripts/manuales/optimizar-imagenes.mjs",
    "manuales:build": "node scripts/manuales/build.mjs",
    "manuales:word": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manuales/word-actualizar.ps1"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
