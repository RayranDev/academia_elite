// Schema Prisma — Fútbol Career Mode (producción: Supabase PostgreSQL)
// Decisión §Sprint 8: los campos tipo enum se mantienen como String validados
// por Zod y tipados con union types en src/types/ (migrar a enums nativos de
// Postgres queda diferido). El comentario `// enum:` documenta los valores.
//
// Conexiones (Prisma 7: las URLs NO van en el schema):
// - Runtime: adapter en `src/lib/db.ts` con DATABASE_URL = pooler de Supabase
//   (transaction mode, puerto 6543, `?pgbouncer=true`).
// - CLI (migrate/seed): `prisma.config.ts` con DIRECT_URL = conexión directa (5432).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  nombre              String
  rol                 String // enum: SUPER_ADMIN | ESCUELA_ADMIN | DT | JUGADOR
  telefono            String? // contacto de la familia (nómina / emergencias)
  escuelaId           String?
  escuela             Escuela?       @relation(fields: [escuelaId], references: [id])
  entrenador          Entrenador?
  jugadores           Jugador[] // un padre puede tener varios hijos
  jugadorCuenta       Jugador?       @relation("CuentaJugador")
  mensajesEnviados    Mensaje[]      @relation("MensajesEnviados")
  notificaciones      Notificacion[]
  tokensAuth          TokenAuth[]
  activo              Boolean        @default(true)
  // Verificación de correo (G-email): el responsable confirma su correo.
  emailVerificado     Boolean        @default(false)
  emailVerificadoEn   DateTime?
  // Habeas data: prueba de aceptación de la Política de Tratamiento de Datos al
  // registrarse (art. 6 Ley 1581 — autorización conservada con fecha y versión).
  terminosAceptadosEn DateTime?
  terminosVersion     String?
  // Bloqueo de acceso (familias): lo gestionan Escuela y Súper Admin.
  bloqueado           Boolean        @default(false)
  bloqueoTipo         String? // enum: PAGO | COMPORTAMIENTO | CONTACTA_DT | PERSONALIZADO
  bloqueoMensaje      String? // solo PERSONALIZADO
  bloqueadoEn         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([escuelaId])
}

// Token de un solo uso para flujos de correo (recuperación, set-password,
// verificación de email, OTP). Se guarda el HASH SHA-256 del token/código, nunca
// el texto. Por usuario (no por tenant): no lleva escuelaId.
model TokenAuth {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo       String // enum: RECUPERACION | SET_PASSWORD | VERIFICACION_EMAIL | OTP | CAMBIO_EMAIL
  tokenHash  String    @unique // SHA-256 del token/código (nunca el texto)
  intentos   Int       @default(0) // guard anti-fuerza-bruta para OTP
  // Correo pendiente de confirmar (solo tipo CAMBIO_EMAIL): el nuevo email al
  // que se aplicará el cambio recién cuando el usuario confirme el código.
  emailNuevo String?
  expiraEn   DateTime
  usadoEn    DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, tipo])
}

model Escuela {
  id                       String             @id @default(cuid())
  nombre                   String
  slug                     String             @unique
  codigoRef                String?            @unique // código humano de referencia (soporte): "ESC-7F4A2"
  logoUrl                  String?
  colorPrimario            String             @default("#4ADE80")
  frecuenciaEvaluacionDias Int                @default(30)
  topeBonusEntreEvals      Int                @default(3)
  activa                   Boolean            @default(true)
  users                    User[]
  sedes                    Sede[]
  categorias               Categoria[]
  entrenadores             Entrenador[]
  jugadores                Jugador[]
  eventos                  Evento[]
  conversaciones           Conversacion[]
  anuncios                 Anuncio[]
  codigos                  CodigoInvitacion[]
  parametros               ParametroEscuela[]
  aranceles                Arancel[]
  egresos                  Egreso[]
  descuentoReglas          DescuentoRegla[]
  createdAt                DateTime           @default(now())
}

model Sede {
  id        String   @id @default(cuid())
  escuelaId String
  escuela   Escuela  @relation(fields: [escuelaId], references: [id])
  nombre    String
  direccion String?
  canchas   Cancha[]

  @@index([escuelaId])
}

model Cancha {
  id      String   @id @default(cuid())
  sedeId  String
  sede    Sede     @relation(fields: [sedeId], references: [id])
  nombre  String
  eventos Evento[]
}

model Categoria {
  id           String                @id @default(cuid())
  escuelaId    String
  escuela      Escuela               @relation(fields: [escuelaId], references: [id])
  nombre       String // "Sub-12"
  anioDesde    Int
  anioHasta    Int
  jugadores    Jugador[]
  entrenadores EntrenadorCategoria[]
  eventos      Evento[]
  anuncios     Anuncio[]
  aranceles    Arancel[]
  descuentoReglas DescuentoRegla[]

  @@index([escuelaId])
}

model Entrenador {
  id           String                @id @default(cuid())
  userId       String                @unique
  user         User                  @relation(fields: [userId], references: [id])
  escuelaId    String
  escuela      Escuela               @relation(fields: [escuelaId], references: [id])
  categorias   EntrenadorCategoria[]
  evaluaciones Evaluacion[]

  @@index([escuelaId])
}

model EntrenadorCategoria {
  entrenadorId String
  categoriaId  String
  entrenador   Entrenador @relation(fields: [entrenadorId], references: [id])
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])

  @@id([entrenadorId, categoriaId])
}

model Jugador {
  id                           String               @id @default(cuid())
  escuelaId                    String
  escuela                      Escuela              @relation(fields: [escuelaId], references: [id])
  categoriaId                  String
  categoria                    Categoria            @relation(fields: [categoriaId], references: [id])
  padreUserId                  String?
  padre                        User?                @relation(fields: [padreUserId], references: [id])
  cuentaUserId                 String?              @unique
  cuentaUser                   User?                @relation("CuentaJugador", fields: [cuentaUserId], references: [id])
  codigoJugador                String?              @unique // código propio del jugador para que el padre lo vincule
  codigoRef                    String?              @unique // código humano de referencia (soporte): "JUG-7F4A2"
  nombre                       String
  apellido                     String
  fechaNacimiento              DateTime
  parentescoAcudiente          String? // relación del acudiente (Madre, Padre, Tío…)
  posicion                     String // enum: POR | DEF | MED | DEL
  dorsal                       Int?
  estado                       String               @default("PENDIENTE") // enum: PENDIENTE | ACTIVO | INACTIVO
  fotoUrl                      String?
  avatarConfig                 String? // JSON del avatar SVG (género, piel, peinado, cabello)
  consentimientoFoto           Boolean              @default(false)
  consentimientoFotoFecha      DateTime?
  // Ficha administrativa y médica (HABEAS-DATA.md, datos sensibles de salud).
  // Todo opcional: la escuela opera sin esta ficha, la familia decide cargarla.
  // Sin `autorizaDatosSalud`, los campos de salud no se muestran a nadie aunque
  // estén guardados (mismo patrón que `consentimientoFoto`, categoría distinta).
  tipoDocumento                String? // RC | TI | CC | CE
  numeroDocumento              String?
  autorizaDatosSalud           Boolean              @default(false)
  autorizacionDatosSaludEn     DateTime?
  eps                          String?
  rh                           String?
  alergias                     String?
  condicionesMedicas           String?
  aptoMedicoVence              DateTime?
  contactoEmergenciaNombre     String?
  contactoEmergenciaTelefono   String?
  contactoEmergenciaParentesco String?
  autorizaTraslado             Boolean              @default(false)
  evaluaciones                 Evaluacion[]
  stats                        StatsCalculados[]
  asistencias                  Asistencia[]
  convocatorias                JugadorConvocado[]
  estadisticasPartido          EstadisticaPartido[]
  logros                       LogroJugador[]
  objetivos                    ObjetivoJugador[]
  observaciones                ObservacionJugador[]
  progresos                    ProgresoSemanal[]
  fondosDesbloqueados          FondoDesbloqueado[]
  fondoEquipadoId              String?
  fondoEquipado                FondoCarta?          @relation("FondoEquipado", fields: [fondoEquipadoId], references: [id])
  descuentos                   JugadorDescuento[]
  // Curva de desarrollo: bonus de MEN ganado por asistencia entre evaluaciones
  // (lo recalcula a diario el cron; acotado y recuperable, ver src/lib/curva.ts).
  menBonus                     Float                @default(0)
  menBonusActualizado          DateTime?
  createdAt                    DateTime             @default(now())

  @@index([escuelaId, categoriaId])
  @@index([padreUserId])
}

model CodigoInvitacion {
  id          String   @id @default(cuid())
  escuelaId   String
  escuela     Escuela  @relation(fields: [escuelaId], references: [id])
  categoriaId String
  codigo      String   @unique // 8 chars alfanum, generado cripto-seguro
  usosMaximos Int      @default(1)
  usos        Int      @default(0)
  expiraEn    DateTime
  activo      Boolean  @default(true)

  @@index([escuelaId])
}

model Evaluacion {
  id                    String           @id @default(cuid())
  escuelaId             String
  jugadorId             String
  jugador               Jugador          @relation(fields: [jugadorId], references: [id])
  entrenadorId          String
  entrenador            Entrenador       @relation(fields: [entrenadorId], references: [id])
  fecha                 DateTime         @default(now())
  anulada               Boolean          @default(false) // solo admin, auditado
  // 4 físicas (medidas crudas)
  sprint30mSeg          Float
  saltoVerticalCm       Float
  agilidadIllinoisSeg   Float
  resistenciaYoyoNivel  Float
  // 4 técnicas (nota 1-10)
  controlBalon          Float
  pase                  Float
  tiro                  Float
  regate                Float
  // 4 mentalidad (nota 1-10)
  actitud               Float
  concentracion         Float
  trabajoEquipo         Float
  resiliencia           Float
  observacionesPrivadas String? // visible solo padre + DT
  statsCalculados       StatsCalculados?

  @@index([escuelaId, jugadorId])
}

model StatsCalculados {
  id             String     @id @default(cuid())
  escuelaId      String
  jugadorId      String
  jugador        Jugador    @relation(fields: [jugadorId], references: [id])
  evaluacionId   String     @unique
  evaluacion     Evaluacion @relation(fields: [evaluacionId], references: [id])
  rit            Int
  tir            Int
  pas            Int
  reg            Int
  def            Int
  fis            Int
  men            Int
  ovr            Int
  nivel          String // enum: BRONCE | PLATA | ORO | HEROE
  bonusAplicado  Int        @default(0) // suma de bonus incluida en esta carta
  versionFormula String     @default("v1.1")
  createdAt      DateTime   @default(now())

  @@index([escuelaId, jugadorId])
}

model Evento {
  id                 String               @id @default(cuid())
  escuelaId          String
  escuela            Escuela              @relation(fields: [escuelaId], references: [id])
  categoriaId        String
  categoria          Categoria            @relation(fields: [categoriaId], references: [id])
  canchaId           String?
  cancha             Cancha?              @relation(fields: [canchaId], references: [id])
  tipo               String // enum: PARTIDO | ENTRENAMIENTO | EVALUACION | OTRO
  titulo             String // "vs. Academia Sur" / "Entrenamiento técnico"
  rival              String? // solo PARTIDO
  esLocal            Boolean? // solo PARTIDO
  inicio             DateTime
  fin                DateTime
  notas              String?
  cancelado          Boolean              @default(false)
  resultadoLocal     Int? // carga post-partido (opcional, para el hub)
  resultadoVisitante Int?
  // Modo Sesión (PLAN-UX-DT PR-1): el DT corre el evento como flujo guiado.
  sesionIniciadaAt   DateTime? // cuándo arrancó el modo (base del cronómetro)
  sesionCerradaAt    DateTime? // cierre confirmado; a partir de acá, editar = corrección
  notaSesion         String? // nota general del paso de cierre
  // Partido v2: estructura real del partido (dos tiempos, alargue, penales).
  // enum: NO_INICIADO | PRIMER_TIEMPO | ENTRETIEMPO | SEGUNDO_TIEMPO |
  //       ALARGUE_1 | DESCANSO_ALARGUE | ALARGUE_2 | PENALES | FINALIZADO
  periodo            String               @default("NO_INICIADO")
  periodoIniciadoAt  DateTime? // base del cronómetro DEL PERÍODO en curso
  penalesLocal       Int? // definición por penales: marcador aparte del de juego
  penalesVisitante   Int?
  convocados         JugadorConvocado[]
  asistencias        Asistencia[]
  estadisticas       EstadisticaPartido[]
  createdAt          DateTime             @default(now())

  @@index([escuelaId, categoriaId, inicio])
}

// Estadística individual de un jugador en un PARTIDO (la carga el DT junto al
// marcador). Una fila por (evento, jugador). Es informativa hoy; en una fase
// posterior puede alimentar la curva de desarrollo.
model EstadisticaPartido {
  id          String  @id @default(cuid())
  escuelaId   String
  eventoId    String
  evento      Evento  @relation(fields: [eventoId], references: [id])
  jugadorId   String
  jugador     Jugador @relation(fields: [jugadorId], references: [id])
  titular     Boolean @default(false)
  // Decisión de producto (ver DECISIONES.md #75): la app dejó de leer/escribir
  // minutos jugados (solo cuenta asistencia, no minutos, para no afectar la
  // percepción de la familia). La columna NO se elimina: preserva el historial
  // de partidos ya jugados. Queda con su @default(0) intacto.
  minutos     Int     @default(0)
  goles       Int     @default(0)
  asistencias Int     @default(0)
  amarillas   Int     @default(0)
  roja        Boolean @default(false)
  azul        Boolean @default(false) // expulsión temporal (algunas ligas de base)

  @@unique([eventoId, jugadorId])
  @@index([escuelaId, jugadorId])
}

model JugadorConvocado {
  eventoId     String
  jugadorId    String
  evento       Evento    @relation(fields: [eventoId], references: [id])
  jugador      Jugador   @relation(fields: [jugadorId], references: [id])
  confirmacion String    @default("PENDIENTE") // enum: PENDIENTE | CONFIRMADO | RECHAZADO
  confirmadoEn DateTime?

  @@id([eventoId, jugadorId])
}

// Asistencia a un evento. El estado de 3 posiciones de la UI mapea así:
// Presente = {presente:true, justificado:false} · Ausente = {presente:false,
// justificado:false} · Justificado = {presente:false, justificado:true}.
// `llegoTarde`/`salioAntes` son MODIFICADORES de Presente.
model Asistencia {
  id        String  @id @default(cuid())
  escuelaId String
  eventoId  String
  evento    Evento  @relation(fields: [eventoId], references: [id])
  jugadorId String
  jugador   Jugador @relation(fields: [jugadorId], references: [id])
  presente  Boolean

  justificado      Boolean   @default(false)
  llegoTarde       Boolean   @default(false)
  salioAntes       Boolean   @default(false)
  agregadoEnCancha Boolean   @default(false)
  marcadoAt        DateTime?
  // Si el evento ya estaba cerrado, la marca es una CORRECCIÓN: se registra
  // cuándo y quién, y el detalle la muestra como "editado".
  corregidoAt      DateTime?
  corregidoPorId   String?

  @@unique([eventoId, jugadorId])
  @@index([escuelaId, jugadorId])
}

// Observación del DT sobre un jugador, hecha en caliente durante la sesión.
// `visiblePadre` decide si la familia la ve (default: privada del cuerpo técnico).
model ObservacionJugador {
  id           String   @id @default(cuid())
  escuelaId    String
  jugadorId    String
  jugador      Jugador  @relation(fields: [jugadorId], references: [id])
  entrenadorId String
  eventoId     String?
  texto        String // máx 500 (se valida en Zod, no en el schema)
  visiblePadre Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([escuelaId, jugadorId, createdAt])
  @@index([eventoId])
}

model Conversacion {
  id        String    @id @default(cuid())
  escuelaId String
  escuela   Escuela   @relation(fields: [escuelaId], references: [id])
  jugadorId String // hilo SIEMPRE anclado a un jugador concreto
  asunto    String
  mensajes  Mensaje[]
  cerrada   Boolean   @default(false)
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@index([escuelaId, jugadorId])
}

model Mensaje {
  id                   String       @id @default(cuid())
  conversacionId       String
  conversacion         Conversacion @relation(fields: [conversacionId], references: [id])
  remitenteId          String
  remitente            User         @relation("MensajesEnviados", fields: [remitenteId], references: [id])
  cuerpo               String // texto plano, máx 2000
  leidoPorDestinatario Boolean      @default(false)
  createdAt            DateTime     @default(now())

  @@index([conversacionId, createdAt])
}

model Anuncio {
  id             String     @id @default(cuid())
  escuelaId      String
  escuela        Escuela    @relation(fields: [escuelaId], references: [id])
  categoriaId    String? // null = toda la escuela
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  autorRol       String // DT | ESCUELA_ADMIN
  autorId        String? // quién lo publicó (para mostrar el nombre); nullable para históricos
  titulo         String
  cuerpo         String // texto plano
  visibleJugador Boolean    @default(false) // "mostrar al jugador" -> noticia del club
  fijado         Boolean    @default(false)
  caducaEn       DateTime? // vencimiento opcional: al pasar, se oculta al jugador
  createdAt      DateTime   @default(now())

  @@index([escuelaId, categoriaId, createdAt])
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tipo      String // enum: EVALUACION_VENCIDA | CONVOCATORIA | MENSAJE | LOGRO | ANUNCIO | SISTEMA | NUEVO_LEAD
  titulo    String
  cuerpo    String?
  url       String? // deep-link interno
  prioridad String   @default("media") // enum: baja | media | alta | critica
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, leida, createdAt])
}

model Logro {
  id          String         @id @default(cuid())
  codigo      String         @unique // "ASISTENCIA_PERFECTA_SEMANA"
  nombre      String
  descripcion String
  tipo        String // enum: INSIGNIA | BONUS
  statBonus   String? // enum: RIT|TIR|PAS|REG|DEF|FIS|MEN (solo BONUS)
  valorBonus  Int? // normalmente 1
  repetible   Boolean        @default(false)
  icono       String // nombre de icono/lottie
  posicion    String? // enum: POR | DEF | MED | DEL · null = general
  activo      Boolean        @default(true) // desactivado = no otorgable
  escuelaId   String? // null = catálogo global; con valor = logro propio de la escuela
  jugadores   LogroJugador[]
  escuelas    LogroEscuela[]

  @@index([posicion, activo])
}

// Disponibilidad de un logro del catálogo por escuela: activación y ventana
// programada (desde/hasta) que gestiona el DT.
model LogroEscuela {
  id        String    @id @default(cuid())
  escuelaId String
  logroId   String
  logro     Logro     @relation(fields: [logroId], references: [id])
  activo    Boolean   @default(true)
  desde     DateTime?
  hasta     DateTime?

  @@unique([escuelaId, logroId])
  @@index([escuelaId])
}

model LogroJugador {
  id             String   @id @default(cuid())
  escuelaId      String
  jugadorId      String
  jugador        Jugador  @relation(fields: [jugadorId], references: [id])
  logroId        String
  logro          Logro    @relation(fields: [logroId], references: [id])
  otorgadoEn     DateTime @default(now())
  bonusConsumido Boolean  @default(false) // true cuando ya se aplicó en una evaluación

  @@index([escuelaId, jugadorId])
}

model ObjetivoJugador {
  id                    String   @id @default(cuid())
  escuelaId             String
  jugadorId             String
  jugador               Jugador  @relation(fields: [jugadorId], references: [id])
  creadoPorEntrenadorId String
  stat                  String // RIT|TIR|PAS|REG|DEF|FIS|MEN|OVR
  valorMeta             Int
  fechaLimite           DateTime
  estado                String   @default("ACTIVO") // enum: ACTIVO | CUMPLIDO | VENCIDO

  @@index([escuelaId, jugadorId])
}

// Progreso personal (crecimiento fuera de la cancha): el responsable valida
// una vez por semana los hábitos del jugador. Genera XP y los atributos
// Mentalidad/Disciplina, independientes del rendimiento deportivo (no toca OVR).
model ProgresoSemanal {
  id             String   @id @default(cuid())
  escuelaId      String
  jugadorId      String
  jugador        Jugador  @relation(fields: [jugadorId], references: [id])
  semana         String // lunes ISO de la semana validada, "2026-06-08"
  academico      Boolean  @default(false) // logros académicos
  comportamiento Boolean  @default(false)
  puntualidad    Boolean  @default(false)
  ayudaCasa      Boolean  @default(false) // ayuda en casa
  valores        Boolean  @default(false) // valores personales
  nota           String? // comentario opcional del responsable
  validadoPorId  String // User (padre/responsable) que validó
  createdAt      DateTime @default(now())

  @@unique([jugadorId, semana])
  @@index([escuelaId, jugadorId])
}

model Lead {
  id                   String     @id @default(cuid())
  nombreEscuela        String
  contactoNombre       String
  contactoEmail        String
  telefono             String?
  ciudad               String?
  mensaje              String?
  // enum: NUEVO | CONTACTADO | EN_SEGUIMIENTO | RECONTACTAR | NEGOCIACION |
  //       PRUEBA_GRATUITA | PENDIENTE_PAGO | CONVERTIDO | DESCARTADO | NO_INTERESADO
  estado               String     @default("NUEVO")
  origen               String? // de dónde vino el lead ("LANDING", "REFERIDO", ...)
  responsableId        String? // userId del comercial a cargo del seguimiento
  proximaAccion        String? // siguiente paso acordado
  fechaProximoContacto DateTime?
  observaciones        String?
  notas                LeadNota[]
  createdAt            DateTime   @default(now())
}

// Historial de seguimiento comercial de un lead (mini-CRM).
model LeadNota {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuarioId  String // userId del autor de la nota
  comentario String
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

model ParametroFormula {
  id          String   @id @default(cuid())
  clave       String   @unique // "PESO_MEN_EN_OVR", "RANGO_SPRINT_SUB12_MIN", ...
  valor       Float
  descripcion String?
  updatedAt   DateTime @updatedAt
}

// Fondos de carta desbloqueables por méritos (gamificación). El requisito es
// configurable por fondo: SIEMPRE, LOGRO (código), NIVEL_CARTA (Bronce/Plata/
// Oro/Héroe) o NIVEL_PERSONAL (nivel mínimo de progreso personal).
model FondoCarta {
  id             String              @id @default(cuid())
  codigo         String              @unique
  nombre         String
  descripcion    String
  estilo         String // CSS (gradiente/patrón) que se aplica a TODA la carta
  colorTexto     String? // color de texto para contraste sobre el fondo (def. claro)
  requisitoTipo  String // SIEMPRE | LOGRO | NIVEL_CARTA | NIVEL_PERSONAL
  requisitoValor String? // logro.codigo · nivel de carta · nivel personal (número)
  orden          Int                 @default(0)
  efecto         String              @default("NINGUNO") // NINGUNO | METALICO | HIELO | TRAMA | HOLOGRAFICO
  efectoParams   Json? // { intensidad?, tinte?, tramaPatron?, velocidad? } — afina el efecto
  desbloqueos    FondoDesbloqueado[]
  equipadoPor    Jugador[]           @relation("FondoEquipado")
}

model FondoDesbloqueado {
  id             String     @id @default(cuid())
  jugadorId      String
  jugador        Jugador    @relation(fields: [jugadorId], references: [id])
  fondoId        String
  fondo          FondoCarta @relation(fields: [fondoId], references: [id])
  desbloqueadoEn DateTime   @default(now())

  @@unique([jugadorId, fondoId])
  @@index([jugadorId])
}

// M9: override por escuela de un parámetro global (solo RANGO_* y UMBRAL_*).
// Lo que no tenga override usa el valor global de ParametroFormula.
model ParametroEscuela {
  id        String   @id @default(cuid())
  escuelaId String
  escuela   Escuela  @relation(fields: [escuelaId], references: [id])
  clave     String
  valor     Float
  updatedAt DateTime @updatedAt

  @@unique([escuelaId, clave])
  @@index([escuelaId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRol  String
  accion    String // "ANULAR_EVALUACION", "REVOCAR_CONSENTIMIENTO", ...
  entidad   String // "Evaluacion"
  entidadId String
  escuelaId String?
  motivo    String?
  createdAt DateTime @default(now())

  @@index([escuelaId, createdAt])
}

model Membresia {
  id             String    @id @default(cuid())
  escuelaId      String
  jugadorId      String
  periodo        String // "2026-06"
  // Qué se está cobrando. Una escuela no cobra solo la mensualidad: también
  // matrícula, indumentaria, torneos. Por eso el unique incluye el concepto.
  concepto       String    @default("MENSUALIDAD") // MENSUALIDAD | MATRICULA | INDUMENTARIA | TORNEO | TRANSPORTE | OTRO
  estado         String    @default("PENDIENTE") // PENDIENTE | PAGADA | VENCIDA
  // Dinero en Decimal, nunca Float: en punto flotante 0.1 + 0.2 !== 0.3, y una
  // cobranza que arrastra ese error termina en diferencias de centavos que nadie
  // puede explicar. Los DTOs lo convierten a `number` (nunca sale un Decimal de
  // Prisma hacia la UI).
  monto          Decimal?  @db.Decimal(12, 2)
  descuento      Decimal?  @db.Decimal(12, 2) // becas, descuento por hermano, etc.
  // Registro del pago: un estado "PAGADA" sin cuándo, cómo ni comprobante no es
  // auditable ni sirve para conciliar contra el banco.
  pagadaEn       DateTime?
  medioPago      String? // EFECTIVO | TRANSFERENCIA | NEQUI | DAVIPLATA | OTRO
  referenciaPago String? // número de comprobante / referencia bancaria

  @@unique([escuelaId, jugadorId, periodo, concepto])
  @@index([escuelaId])
}

// Lista de precios de la escuela. Sin esto no hay forma de generar la cobranza
// del mes sin tipear el monto jugador por jugador.
//
// No lleva unique por (categoría, concepto) A PROPÓSITO: guardar varias filas con
// distinto `vigenteDesde` es el historial de precios. El precio aplicable se
// resuelve con `resolverArancel` (src/lib/aranceles.ts), que toma el más reciente
// ya vigente y cae al general de la escuela (`categoriaId = null`) si esa
// categoría no tiene precio propio.
model Arancel {
  id           String     @id @default(cuid())
  escuelaId    String
  escuela      Escuela    @relation(fields: [escuelaId], references: [id])
  categoriaId  String? // null = precio general de la escuela
  categoria    Categoria? @relation(fields: [categoriaId], references: [id])
  concepto     String // MENSUALIDAD | MATRICULA | INDUMENTARIA | TORNEO | TRANSPORTE | OTRO
  monto        Decimal    @db.Decimal(12, 2)
  // Texto libre, sobre todo para el concepto OTRO: sin esto, un precio "OTRO"
  // queda sin contexto para cuando alguien lo audite después.
  descripcion  String?
  vigenteDesde DateTime   @default(now())
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([escuelaId, concepto])
}

// Regla de descuento reusable, por categoría (como Arancel), que se aplica sola
// al generar la cobranza masiva del mes (generarCuotasDelPeriodo). Decisiones de
// producto: (1) es por categoría, no por escuela completa; (2) si un jugador
// califica para más de una regla, gana la de MAYOR descuento en pesos, no se
// combinan (ver `resolverDescuento` en src/lib/cobranza.ts); (3) "Hermano" se
// asigna a mano por el ESCUELA_ADMIN, no hay detección automática.
//
// Sin baja lógica tipo "reemplazar" de Arancel: un duplicado (misma
// categoría+nombre, ambas activas) se rechaza en el servicio con un error claro.
model DescuentoRegla {
  id          String             @id @default(cuid())
  escuelaId   String
  escuela     Escuela            @relation(fields: [escuelaId], references: [id])
  categoriaId String
  categoria   Categoria          @relation(fields: [categoriaId], references: [id])
  nombre      String // "Hermano", "Beca deportiva" — texto libre corto
  tipo        String // enum: PORCENTAJE | MONTO_FIJO
  valor       Decimal            @db.Decimal(12, 2) // % (0-100) o monto fijo según `tipo`
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  jugadores   JugadorDescuento[]

  @@index([escuelaId, categoriaId])
}

// Asignación manual de un jugador a una regla de descuento. Un jugador puede
// tener varias asignaciones; `resolverDescuento` elige la de mayor descuento.
model JugadorDescuento {
  jugadorId  String
  reglaId    String
  jugador    Jugador        @relation(fields: [jugadorId], references: [id])
  regla      DescuentoRegla @relation(fields: [reglaId], references: [id])
  asignadaEn DateTime       @default(now())

  @@id([jugadorId, reglaId])
}

// Egreso de caja de la escuela (gasto operativo: cancha, árbitro, sueldos, ...).
// A diferencia de `Membresia.monto` (opcional: una cuota puede crearse antes de
// tener precio resuelto), acá `monto` es obligatorio — un egreso sin monto no
// es un gasto, es un recordatorio, y este módulo no modela recordatorios.
// `fecha` es cuándo se pagó/gastó, no `createdAt` (cuándo se cargó el registro):
// una escuela puede cargar hoy un gasto de la semana pasada, y el reporte de
// caja del período tiene que ubicarlo en su fecha real, no en la de carga.
model Egreso {
  id             String   @id @default(cuid())
  escuelaId      String
  escuela        Escuela  @relation(fields: [escuelaId], references: [id])
  concepto       String // enum: CANCHA | ARBITRO | INDUMENTARIA | TRANSPORTE | MANTENIMIENTO | SUELDOS | OTRO
  monto          Decimal  @db.Decimal(12, 2)
  fecha          DateTime
  descripcion    String?
  medioPago      String? // EFECTIVO | TRANSFERENCIA | NEQUI | DAVIPLATA | OTRO (mismos valores que Membresia)
  referenciaPago String?
  createdAt      DateTime @default(now())

  @@index([escuelaId, fecha])
}

// Sesión de soporte: puerta explícita, temporal y auditada por la que el
// SUPER_ADMIN accede a los datos operativos de una escuela (ROL-SUPER-ADMIN.md M2).
// Sin sesión activa, assertTenant le niega el detalle de un tenant.
model SoporteSesion {
  id           String    @id @default(cuid())
  superAdminId String
  escuelaId    String
  motivo       String
  soloLectura  Boolean   @default(true)
  iniciadaEn   DateTime  @default(now())
  finalizadaEn DateTime?

  @@index([superAdminId, finalizadaEn])
  @@index([escuelaId])
}
